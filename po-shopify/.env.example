# Shopify store subdomain (without .myshopify.com)
SHOP=gastronom-ae

# Shopify custom app credentials
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret

# Shopify Location GID (Dubai Investment Park First warehouse)
LOCATION_ID=gid://shopify/Location/63740641449

# Set to false to actually apply changes
DRY_RUN=true

